# DispatchArc production configuration example.
#
# Supply real secrets through the deployment platform's
# secret/environment configuration. Do not commit real values.

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__Database=Host=YOUR_DATABASE_HOST;Port=5432;Database=dispatcharc;Username=dispatcharc_app;Password=YOUR_DATABASE_PASSWORD

Jwt__Issuer=DispatchArc.Api
Jwt__Audience=DispatchArc.Client
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
Jwt__ExpirationMinutes=60

# Leave false when DispatchArc terminates HTTPS directly.
#
# Enable only when deployed behind a reverse proxy/load balancer.
ReverseProxy__Enabled=false

# When enabled, explicitly configure trusted proxy IP addresses:
# ReverseProxy__KnownProxies__0=10.0.0.10
# ReverseProxy__KnownProxies__1=10.0.0.11